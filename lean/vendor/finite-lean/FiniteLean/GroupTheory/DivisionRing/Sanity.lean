import FiniteLean.GroupTheory.DivisionRing.Freeness

/-!
# Non-vacuity checks for the definitions of `Freeness.lean`

* For every division ring `K`, the isomorphism `φ : K[Unit] ≃+* K` is Linnell, strongly
  Hughes-free and satisfies (HF) (`unit_isLinnell`, `unit_isStronglyHughesFree`,
  `unit_satisfiesHF`). So none of `IsLinnell`, `IsStronglyHughesFree`, `SatisfiesHF` is
  unsatisfiable, and `¬ IsLinnell φ` etc. in `thm:linnell` are genuine conclusions.
* For `Λ = Multiplicative ℤ`, the hypotheses of (HF) are inhabited: `⊤` is finitely generated,
  `⊥` is normal in `⊤`, and `⊤ / ⊥` is infinite cyclic generated by `ofAdd 1`
  (`int_hf_premises`). (For `Λ = Unit` they are empty, so `unit_satisfiesHF` alone would not show
  that (HF) has content.)
-/

namespace NonSofic

open MonoidAlgebra

section Unit

variable (K : Type*) [DivisionRing K]

/-- `K[Unit] ≅ K`. -/
noncomputable def unitHom : MonoidAlgebra K Unit →+* K :=
  (MonoidAlgebra.uniqueRingEquiv Unit).toRingHom

theorem unit_isEpic : IsEpic (unitHom K) := by
  rw [IsEpic, eq_top_iff]
  intro x _
  refine subset_divClosure (unitHom K) ⊤ ⟨(MonoidAlgebra.uniqueRingEquiv Unit).symm x,
    fun g _ => Subgroup.mem_top g, ?_⟩
  exact (MonoidAlgebra.uniqueRingEquiv Unit).apply_symm_apply x

theorem unit_isFreeFor (C C' : Subgroup Unit) : IsFreeFor (unitHom K) C C' := by
  intro n g d hn _ hc _ hd0
  set j0 : Fin n := ⟨0, hn⟩
  have hall : ∀ j, j = j0 := by
    intro j
    by_contra hj
    exact hc j j0 hj (by rw [Subsingleton.elim (g j * (g j0)⁻¹) 1]; exact C.one_mem)
  rw [Finset.sum_eq_single j0 (fun j _ hj => absurd (hall j) hj) (fun h => absurd
    (Finset.mem_univ j0) h)]
  exact mul_ne_zero (hd0 j0) (map_of_ne_zero _ _)

theorem unit_isLinnell : IsLinnell (unitHom K) :=
  ⟨unit_isEpic K, fun C => unit_isFreeFor K C ⊤⟩

theorem unit_isStronglyHughesFree : IsStronglyHughesFree (unitHom K) :=
  (unit_isLinnell K).isStronglyHughesFree

theorem unit_satisfiesHF : SatisfiesHF (unitHom K) :=
  (unit_isLinnell K).satisfiesHF

end Unit

/-- The hypotheses of (HF) are satisfiable: in `Multiplicative ℤ`, `⊤` is finitely generated,
`⊥` is normal in `⊤`, and `⊤ / ⊥` is infinite cyclic generated by `ofAdd 1`. -/
theorem int_hf_premises :
    IsFinitelyGenerated (⊤ : Subgroup (Multiplicative ℤ)) ∧
      IsNormalIn (⊥ : Subgroup (Multiplicative ℤ)) ⊤ ∧
      IsInfCyclicQuotient (⊥ : Subgroup (Multiplicative ℤ)) ⊤ (Multiplicative.ofAdd 1) := by
  have hpow : ∀ k : ℤ, Multiplicative.ofAdd (1 : ℤ) ^ k = Multiplicative.ofAdd k := fun k => by
    rw [← ofAdd_zsmul, smul_eq_mul, mul_one]
  refine ⟨⟨{Multiplicative.ofAdd 1}, ?_⟩, ⟨bot_le, fun x _ c hc => ?_⟩,
    ⟨Subgroup.mem_top _, fun g _ => ⟨Multiplicative.toAdd g, ?_⟩, fun k hk => ?_⟩⟩
  · rw [eq_top_iff]
    intro g _
    have hg : g = Multiplicative.ofAdd (1 : ℤ) ^ (Multiplicative.toAdd g) := by
      rw [hpow]; rfl
    rw [hg]
    exact Subgroup.zpow_mem _ (Subgroup.subset_closure (by simp)) _
  · rw [Subgroup.mem_bot] at hc ⊢
    rw [hc, mul_one, mul_inv_cancel]
  · rw [Subgroup.mem_bot, hpow, inv_mul_eq_one]
    rfl
  · rw [Subgroup.mem_bot, hpow] at hk
    exact Multiplicative.ofAdd.injective hk

end NonSofic
