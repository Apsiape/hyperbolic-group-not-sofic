import FiniteLean.GroupTheory.DivisionRing.LineData

/-!
# The Schur-complement induction of Corollary `cor:split-linnell`

Douglas–Mghirbi v1.1.0, Section 5, proof of Corollary `cor:split-linnell` (algebraic part).

Let `φ : K[Λ] → D` be `(C, Λ)`-free for every subgroup `C` (e.g. Linnell), and let `e u v`
(`u, v ∈ [n]`) be elements of `Λ` that freely generate a subgroup (the homomorphism from the free
group on `Fin n × Fin n` is injective).  Then `φ(M)` is invertible for `M = (e_{uv} - 1)`
(`isUnit_map_sub_one_of_free`).

Proof (as in the paper): by induction on `k`, the leading `k × k` block `φ(M_k)` is invertible,
and its inverse has entries in `D_C` for every `C` containing the `e_{uv}`, `u, v < k`
(`inv_entries_mem`).  For the step, the Schur complement of `φ(M_k)` in `φ(M_{k+1})` is
`φ(e_{kk}) + d` with `d ∈ D_C`, `C = ⟨e_{uv} : u, v ≤ k, (u, v) ≠ (k, k)⟩`; since `e_{kk} ∉ C`,
`(C, Λ)`-freeness gives `φ(e_{kk}) + d ≠ 0` (`IsFreeFor.map_add_ne_zero`), and a square matrix whose
leading block is invertible and whose Schur complement is nonzero is invertible
(`isUnit_of_schur`).
-/

namespace NonSofic

open Matrix MonoidAlgebra

section Matrices

variable {D : Type*} [DivisionRing D]

/-- The inverse of an invertible matrix with entries in a division subring `E` has entries in
`E`. -/
theorem inv_entries_mem {n : Type*} [Fintype n] [DecidableEq n] (E : Subfield D)
    (P Q : Matrix n n D) (hPE : ∀ i j, P i j ∈ E) (hQP : Q * P = 1) (hPQ : P * Q = 1) :
    ∀ i j, Q i j ∈ E := by
  let P' : Matrix n n E := Matrix.of fun i j => ⟨P i j, hPE i j⟩
  have hP' : P'.map E.subtype = P := by ext i j; rfl
  have hunit : IsUnit P' := by
    refine isUnit_of_vecMul_eq_zero P' fun x hx => ?_
    have hx' : (fun i => (x i : D)) ᵥ* P = 0 := by
      rw [← hP']
      funext j
      have := congrArg (fun y : E => (y : D)) (congrFun hx j)
      simpa [Matrix.vecMul, dotProduct] using this
    have h0 : (fun i => (x i : D)) = 0 := by
      calc (fun i => (x i : D)) = (fun i => (x i : D)) ᵥ* (P * Q) := by
            rw [hPQ, Matrix.vecMul_one]
        _ = 0 := by rw [← Matrix.vecMul_vecMul, hx', Matrix.zero_vecMul]
    funext i
    exact Subtype.ext (congrFun h0 i)
  obtain ⟨u, hu⟩ := hunit
  have h1 : P * ((↑u⁻¹ : Matrix n n E).map E.subtype) = 1 := by
    rw [← hP', ← Matrix.map_mul, ← hu, Units.mul_inv,
      Matrix.map_one _ (map_zero E.subtype) (map_one E.subtype)]
  have hQ : Q = (↑u⁻¹ : Matrix n n E).map E.subtype := by
    calc Q = Q * (P * ((↑u⁻¹ : Matrix n n E).map E.subtype)) := by rw [h1, Matrix.mul_one]
      _ = _ := by rw [← Matrix.mul_assoc, hQP, Matrix.one_mul]
  intro i j
  rw [hQ]
  exact ((↑u⁻¹ : Matrix n n E) i j).2

/-- A square matrix whose leading `k × k` block `A` is invertible and whose Schur complement
`P_{kk} - c A⁻¹ b` is nonzero is invertible. -/
theorem isUnit_of_schur {k : ℕ} (P : Matrix (Fin (k + 1)) (Fin (k + 1)) D)
    (Ainv : Matrix (Fin k) (Fin k) D)
    (hA : P.submatrix Fin.castSucc Fin.castSucc * Ainv = 1)
    (hs : P (Fin.last k) (Fin.last k) -
      ((fun w => P (Fin.last k) (Fin.castSucc w)) ᵥ* Ainv) ⬝ᵥ
        (fun v => P (Fin.castSucc v) (Fin.last k)) ≠ 0) : IsUnit P := by
  set A := P.submatrix Fin.castSucc Fin.castSucc
  set c : Fin k → D := fun w => P (Fin.last k) (Fin.castSucc w)
  set b : Fin k → D := fun v => P (Fin.castSucc v) (Fin.last k)
  refine isUnit_of_vecMul_eq_zero P fun x hx => ?_
  set x' : Fin k → D := fun u => x (Fin.castSucc u)
  set xl := x (Fin.last k)
  have h1 : x' ᵥ* A + xl • c = 0 := by
    funext w
    have := congrFun hx (Fin.castSucc w)
    simpa [Matrix.vecMul, dotProduct, Fin.sum_univ_castSucc, A, c, x', xl] using this
  have h2 : x' ⬝ᵥ b + xl * P (Fin.last k) (Fin.last k) = 0 := by
    have := congrFun hx (Fin.last k)
    simpa [Matrix.vecMul, dotProduct, Fin.sum_univ_castSucc, b, x', xl] using this
  have h3 : x' = -(xl • (c ᵥ* Ainv)) := by
    calc x' = x' ᵥ* (A * Ainv) := by rw [hA, Matrix.vecMul_one]
      _ = (x' ᵥ* A) ᵥ* Ainv := by rw [Matrix.vecMul_vecMul]
      _ = (-(xl • c)) ᵥ* Ainv := by rw [eq_neg_of_add_eq_zero_left h1]
      _ = -(xl • (c ᵥ* Ainv)) := by rw [Matrix.neg_vecMul, Matrix.smul_vecMul]
  have hxl : xl = 0 := by
    have h4 : xl * (P (Fin.last k) (Fin.last k) - (c ᵥ* Ainv) ⬝ᵥ b) = 0 := by
      rw [h3, neg_dotProduct, smul_dotProduct, smul_eq_mul, neg_add_eq_sub] at h2
      rw [mul_sub]
      exact h2
    exact (mul_eq_zero.1 h4).resolve_right hs
  have hx' : x' = 0 := by rw [h3, hxl, zero_smul, neg_zero]
  funext i
  refine Fin.lastCases ?_ (fun u => ?_) i
  · exact hxl
  · exact congrFun hx' u

end Matrices

section Group

variable {K : Type*} [Ring K] {Λ : Type*} [Group Λ] {D : Type*} [DivisionRing D]

/-- A free generator is not in the subgroup generated by the other generators. -/
theorem notMem_closure_of_free {α : Type*} [DecidableEq α] (f : α → Λ)
    (hf : Function.Injective (FreeGroup.lift f)) (S : Set α) {p : α} (hp : p ∉ S) :
    f p ∉ Subgroup.closure (f '' S) := by
  intro h
  have himg : f '' S = FreeGroup.lift f '' (FreeGroup.of '' S) := by
    rw [Set.image_image]
    simp
  rw [himg, ← MonoidHom.map_closure] at h
  obtain ⟨g, hg, hgp⟩ := h
  have hg' : g = FreeGroup.of p := hf (by rw [hgp]; simp)
  subst hg'
  let χ : FreeGroup α →* Multiplicative ℤ :=
    FreeGroup.lift fun a => if a = p then Multiplicative.ofAdd 1 else 1
  have hle : Subgroup.closure (FreeGroup.of '' S) ≤ χ.ker := by
    rw [Subgroup.closure_le]
    rintro _ ⟨a, ha, rfl⟩
    have hap : a ≠ p := fun h => hp (h ▸ ha)
    simp [χ, hap]
  have := hle hg
  simp [χ] at this

/-- `(C, Λ)`-freeness: if `g ∉ C` and `d ∈ D_C`, then `φ(g) + d ≠ 0`. -/
theorem IsFreeFor.map_add_ne_zero {φ : MonoidAlgebra K Λ →+* D} {C : Subgroup Λ}
    (hφ : IsFreeFor φ C ⊤) {g : Λ} (hg : g ∉ C) {d : D} (hd : d ∈ divClosure φ C) :
    φ (of K Λ g) + d ≠ 0 := by
  intro h0
  have hc : ∀ i j : Fin 2, i ≠ j → (![g, 1] : Fin 2 → Λ) i * ((![g, 1] : Fin 2 → Λ) j)⁻¹ ∉ C := by
    intro i j hij
    match i, j, hij with
    | ⟨0, _⟩, ⟨0, _⟩, h => exact absurd rfl h
    | ⟨0, _⟩, ⟨1, _⟩, _ => simpa using hg
    | ⟨1, _⟩, ⟨0, _⟩, _ => simpa using hg
    | ⟨1, _⟩, ⟨1, _⟩, h => exact absurd rfl h
    | ⟨n + 2, h⟩, _, _ => exact absurd h (by omega)
    | _, ⟨n + 2, h⟩, _ => exact absurd h (by omega)
  have hmem : ∀ j : Fin 2, (![1, d] : Fin 2 → D) j ∈ divClosure φ C := by
    intro j
    match j with
    | ⟨0, _⟩ => exact (divClosure φ C).one_mem
    | ⟨1, _⟩ => exact hd
    | ⟨n + 2, h⟩ => exact absurd h (by omega)
  have hsum : ∑ j : Fin 2, (![1, d] : Fin 2 → D) j * φ (of K Λ ((![g, 1] : Fin 2 → Λ) j)) = 0 := by
    simpa only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      map_one, one_mul, mul_one] using h0
  have := hφ.coeff_eq_zero ![g, 1] ![1, d] (fun _ => Subgroup.mem_top _) hc hmem hsum 0
  simp at this

/-- **Schur-complement induction of `cor:split-linnell`.** If `φ` is `(C, Λ)`-free for every
subgroup `C` and the `e u v` freely generate a subgroup, then `φ((e u v - 1)_{u,v})` is
invertible. -/
theorem isUnit_map_sub_one_of_free {φ : MonoidAlgebra K Λ →+* D}
    (hφ : ∀ C : Subgroup Λ, IsFreeFor φ C ⊤) {n : ℕ} (e : Fin n → Fin n → Λ)
    (hfree : Function.Injective (FreeGroup.lift fun p : Fin n × Fin n => e p.1 p.2)) :
    IsUnit ((Matrix.of fun u v => of K Λ (e u v) - 1).map φ) := by
  classical
  let f : Fin n × Fin n → Λ := fun p => e p.1 p.2
  let Q : ∀ k, k ≤ n → Matrix (Fin k) (Fin k) D := fun k h =>
    Matrix.of fun u v => φ (of K Λ (e (Fin.castLE h u) (Fin.castLE h v))) - 1
  have key : ∀ k (h : k ≤ n), IsUnit (Q k h) := by
    intro k
    induction k with
    | zero => intro h; exact isUnit_of_subsingleton _
    | succ k ih =>
      intro h
      have hk : k ≤ n := Nat.le_of_succ_le h
      obtain ⟨u, hu⟩ := ih hk
      set P := Q (k + 1) h
      set kk : Fin n := Fin.castLE h (Fin.last k)
      let S : Set (Fin n × Fin n) := {p | p.1.val ≤ k ∧ p.2.val ≤ k ∧ p ≠ (kk, kk)}
      let C : Subgroup Λ := Subgroup.closure (f '' S)
      have hkk : kk.val = k := rfl
      have hfC : ∀ a b : Fin n, a.val ≤ k → b.val ≤ k → (a.val < k ∨ b.val < k) → e a b ∈ C := by
        intro a b ha hb hab
        refine Subgroup.subset_closure ⟨(a, b), ⟨ha, hb, ?_⟩, rfl⟩
        intro heq
        simp only [Prod.mk.injEq] at heq
        rw [heq.1, heq.2, hkk] at hab
        omega
      have hPmem : ∀ a b : Fin n, a.val ≤ k → b.val ≤ k → (a.val < k ∨ b.val < k) →
          φ (of K Λ (e a b)) - 1 ∈ divClosure φ C := fun a b ha hb hab =>
        (divClosure φ C).sub_mem (of_mem_divClosure φ (hfC a b ha hb hab)) (divClosure φ C).one_mem
      have hsub : P.submatrix Fin.castSucc Fin.castSucc = Q k hk := by ext; rfl
      have hAinv : ∀ i j, (↑u⁻¹ : Matrix (Fin k) (Fin k) D) i j ∈ divClosure φ C := by
        refine inv_entries_mem _ (Q k hk) _ (fun i j => ?_) (by rw [← hu, Units.inv_mul])
          (by rw [← hu, Units.mul_inv])
        exact hPmem _ _ (Nat.le_of_lt i.2) (Nat.le_of_lt j.2) (Or.inl i.2)
      refine isUnit_of_schur P ↑u⁻¹ (by rw [hsub, ← hu, Units.mul_inv]) ?_
      -- the Schur complement is `φ(e_kk) + d` with `d ∈ D_C`
      set d : D := -1 - ((fun w => P (Fin.last k) (Fin.castSucc w)) ᵥ* ↑u⁻¹) ⬝ᵥ
        (fun v => P (Fin.castSucc v) (Fin.last k))
      have hd : d ∈ divClosure φ C := by
        refine (divClosure φ C).sub_mem ((divClosure φ C).neg_mem (divClosure φ C).one_mem) ?_
        refine (divClosure φ C).sum_mem fun v _ => (divClosure φ C).mul_mem ?_ ?_
        · rw [Matrix.vecMul, dotProduct]
          refine (divClosure φ C).sum_mem fun w _ => (divClosure φ C).mul_mem ?_ (hAinv w v)
          exact hPmem _ _ le_rfl (Nat.le_of_lt w.2) (Or.inr w.2)
        · exact hPmem _ _ (Nat.le_of_lt v.2) le_rfl (Or.inl v.2)
      have hekk : e kk kk ∉ C :=
        notMem_closure_of_free f hfree S (p := (kk, kk)) (fun h => h.2.2 rfl)
      have hne := (hφ C).map_add_ne_zero hekk hd
      have hP : P (Fin.last k) (Fin.last k) = φ (of K Λ (e kk kk)) - 1 := rfl
      intro h0
      apply hne
      rw [← h0, hP]
      simp only [d, sub_eq_add_neg, add_assoc]
  have hfin : (Matrix.of fun u v => of K Λ (e u v) - 1).map φ = Q n le_rfl := by
    ext u v
    simp [Q, map_sub]
  rw [hfin]
  exact key n le_rfl

/-- In particular for Linnell division rings. -/
theorem IsLinnell.isUnit_map_sub_one {φ : MonoidAlgebra K Λ →+* D} (hφ : IsLinnell φ) {n : ℕ}
    (e : Fin n → Fin n → Λ)
    (hfree : Function.Injective (FreeGroup.lift fun p : Fin n × Fin n => e p.1 p.2)) :
    IsUnit ((Matrix.of fun u v => of K Λ (e u v) - 1).map φ) :=
  isUnit_map_sub_one_of_free hφ.2 e hfree

/-- A diagonal matrix with nonzero entries over a division ring is invertible. -/
theorem isUnit_diagonal_of_ne_zero {n : Type*} [Fintype n] [DecidableEq n] (a : n → D)
    (ha : ∀ i, a i ≠ 0) : IsUnit (Matrix.diagonal a) := by
  refine ⟨⟨Matrix.diagonal a, Matrix.diagonal fun i => (a i)⁻¹, ?_, ?_⟩, rfl⟩
  · rw [Matrix.diagonal_mul_diagonal]; simp [ha, Matrix.diagonal_one]
  · rw [Matrix.diagonal_mul_diagonal]; simp [ha, Matrix.diagonal_one]

/-- **Scaling step of `cor:split-linnell`.** For `g : [k+1] × [k+1] → Λ` put
`e_{uv} = g_{u+1,0}⁻¹ g_{u+1,v+1} g_{0,v+1}⁻¹ g_{00}`.  If `φ((e_{uv} - 1))` is invertible then
`φ((g_{uv}))` is invertible: `diag(φ g_{u0})⁻¹ φ(g) diag(φ g_{00}⁻¹ φ g_{0v})⁻¹` has first row and
column `1` and lower block `φ(e)`, and subtracting the first row leaves `φ(e - 1)`. -/
theorem isUnit_map_of_isUnit_map_sub_one {φ : MonoidAlgebra K Λ →+* D} {k : ℕ}
    (g : Fin (k + 1) → Fin (k + 1) → Λ)
    (h : IsUnit ((Matrix.of fun u v : Fin k =>
      of K Λ ((g u.succ 0)⁻¹ * g u.succ v.succ * (g 0 v.succ)⁻¹ * g 0 0) - 1).map φ)) :
    IsUnit ((Matrix.of fun u v => of K Λ (g u v)).map φ) := by
  classical
  set F : Λ → D := fun x => φ (of K Λ x) with hF
  have hF0 : ∀ x, F x ≠ 0 := fun x => map_of_ne_zero φ x
  have hFmul : ∀ x y, F (x * y) = F x * F y := fun x y => by simp only [hF, map_mul]
  have hFinv : ∀ x, F x⁻¹ = (F x)⁻¹ := fun x => map_of_inv φ x
  set Y := (Matrix.of fun u v => of K Λ (g u v)).map φ
  have hY : ∀ u v, Y u v = F (g u v) := fun u v => rfl
  set a : Fin (k + 1) → D := fun u => F (g u 0)
  set b : Fin (k + 1) → D := fun v => (F (g 0 0))⁻¹ * F (g 0 v)
  have ha : ∀ u, a u ≠ 0 := fun u => hF0 _
  have hb : ∀ v, b v ≠ 0 := fun v => mul_ne_zero (inv_ne_zero (hF0 _)) (hF0 _)
  set Z : Matrix (Fin (k + 1)) (Fin (k + 1)) D := Matrix.of fun u v => (a u)⁻¹ * Y u v * (b v)⁻¹
  have hYZ : Y = Matrix.diagonal a * Z * Matrix.diagonal b := by
    ext u v
    rw [Matrix.mul_diagonal, Matrix.diagonal_mul]
    have e : a u * ((a u)⁻¹ * Y u v * (b v)⁻¹) * b v = Y u v := by
      rw [mul_assoc ((a u)⁻¹), mul_inv_cancel_left₀ (ha u), inv_mul_cancel_right₀ (hb v)]
    exact e.symm
  have hbinv : ∀ v, (b v)⁻¹ = (F (g 0 v))⁻¹ * F (g 0 0) := fun v => by
    simp only [b, mul_inv_rev, inv_inv]
  have hZ0 : ∀ v, Z 0 v = 1 := by
    intro v
    simp only [Z, Matrix.of_apply, hY, hbinv, a]
    rw [mul_assoc, ← mul_assoc (F (g 0 v)), mul_inv_cancel₀ (hF0 _), one_mul,
      inv_mul_cancel₀ (hF0 _)]
  have hZ0' : ∀ u, Z u 0 = 1 := by
    intro u
    simp only [Z, Matrix.of_apply, hY, hbinv, a]
    rw [inv_mul_cancel₀ (hF0 _), one_mul, inv_mul_cancel₀ (hF0 _)]
  have hZs : ∀ u v : Fin k, Z u.succ v.succ =
      F ((g u.succ 0)⁻¹ * g u.succ v.succ * (g 0 v.succ)⁻¹ * g 0 0) := by
    intro u v
    simp only [Z, Matrix.of_apply, hY, hbinv, a, hFmul, hFinv, mul_assoc]
  have hZ : IsUnit Z := by
    obtain ⟨w, hw⟩ := h
    refine isUnit_of_vecMul_eq_zero Z fun x hx => ?_
    set x' : Fin k → D := fun u => x u.succ
    have hcol0 : x 0 + ∑ u, x' u = 0 := by
      have := congrFun hx 0
      simpa [Matrix.vecMul, dotProduct, Fin.sum_univ_succ, hZ0, hZ0', x'] using this
    have hcol : ∀ v : Fin k, x 0 + ∑ u, x' u * F ((g u.succ 0)⁻¹ * g u.succ v.succ *
        (g 0 v.succ)⁻¹ * g 0 0) = 0 := by
      intro v
      have := congrFun hx v.succ
      simp only [Matrix.vecMul, dotProduct, Fin.sum_univ_succ, hZ0, hZs, mul_one,
        Pi.zero_apply] at this
      exact this
    have hx' : x' ᵥ* (↑w : Matrix (Fin k) (Fin k) D) = 0 := by
      funext v
      rw [hw]
      have e1 := hcol v
      rw [← hcol0] at e1
      simp only [Matrix.vecMul, dotProduct, Matrix.map_apply, Matrix.of_apply, map_sub,
        map_one, mul_sub, mul_one, Finset.sum_sub_distrib, Pi.zero_apply]
      have e2 := add_left_cancel e1
      rw [e2, sub_self]
    have hx'0 : x' = 0 := by
      calc x' = x' ᵥ* ((↑w : Matrix (Fin k) (Fin k) D) * ↑w⁻¹) := by
            rw [Units.mul_inv, Matrix.vecMul_one]
        _ = 0 := by rw [← Matrix.vecMul_vecMul, hx', Matrix.zero_vecMul]
    have hsum0 : ∑ u, x' u = 0 := by simp [hx'0]
    have hx0 : x 0 = 0 := by rw [hsum0, add_zero] at hcol0; exact hcol0
    funext i
    refine Fin.cases ?_ (fun u => ?_) i
    · exact hx0
    · exact congrFun hx'0 u
  rw [hYZ]
  exact ((isUnit_diagonal_of_ne_zero a ha).mul hZ).mul (isUnit_diagonal_of_ne_zero b hb)

/-- **Algebraic part of `cor:split-linnell`.** If `φ` is Linnell and the elements
`e_{uv} = g_{u+1,0}⁻¹ g_{u+1,v+1} g_{0,v+1}⁻¹ g_{00}` freely generate a subgroup, then
`φ((g_{uv}))` is invertible. -/
theorem IsLinnell.isUnit_map_of_free {φ : MonoidAlgebra K Λ →+* D} (hφ : IsLinnell φ) {k : ℕ}
    (g : Fin (k + 1) → Fin (k + 1) → Λ)
    (hfree : Function.Injective (FreeGroup.lift fun p : Fin k × Fin k =>
      (g p.1.succ 0)⁻¹ * g p.1.succ p.2.succ * (g 0 p.2.succ)⁻¹ * g 0 0)) :
    IsUnit ((Matrix.of fun u v => of K Λ (g u v)).map φ) :=
  isUnit_map_of_isUnit_map_sub_one g (hφ.isUnit_map_sub_one
    (fun u v => (g u.succ 0)⁻¹ * g u.succ v.succ * (g 0 v.succ)⁻¹ * g 0 0) hfree)

/-- **`cor:split-linnell`, abstract form.** If for every `i` the elements
`g_{i,u+1,0}⁻¹ g_{i,u+1,v+1} g_{i,0,v+1}⁻¹ g_{i,00}` freely generate a subgroup and
`∑ᵢ rank_D φ(g_i) < |I| (k+1) / 4`, then `φ` is not Linnell. -/
theorem not_isLinnell_of_split {φ : MonoidAlgebra K Λ →+* D} {I : Type*} [Fintype I] {k : ℕ}
    (g : I → Fin (k + 1) → Fin (k + 1) → Λ)
    (hfree : ∀ i, Function.Injective (FreeGroup.lift fun p : Fin k × Fin k =>
      (g i p.1.succ 0)⁻¹ * g i p.1.succ p.2.succ * (g i 0 p.2.succ)⁻¹ * g i 0 0))
    (hsum : ∑ i, (rankD ((Matrix.of fun u v => of K Λ (g i u v)).map φ) : ℝ) <
      Fintype.card I * (k + 1 : ℕ) / 4) : ¬ IsLinnell φ := by
  intro hφ
  have hr : ∀ i, rankD ((Matrix.of fun u v => of K Λ (g i u v)).map φ) = k + 1 :=
    fun i => rankD_eq_of_isUnit (hφ.isUnit_map_of_free (g i) (hfree i))
  simp only [hr, Finset.sum_const, Finset.card_univ, nsmul_eq_mul] at hsum
  have h0 : (0 : ℝ) ≤ (Fintype.card I : ℝ) * (k + 1 : ℕ) := by positivity
  linarith

end Group

end NonSofic
