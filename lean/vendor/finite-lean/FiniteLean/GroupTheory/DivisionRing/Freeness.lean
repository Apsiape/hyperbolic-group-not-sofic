import Mathlib.Algebra.MonoidAlgebra.Defs
import Mathlib.Algebra.Field.Subfield.Basic
import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.GroupTheory.Finiteness

/-!
# Division closures, freeness, Linnell and strongly Hughes-free division rings, (HF)

Section 5 of Douglas–Mghirbi, v1.1.0 (definitions after "Let φ : K[Λ] → D be a ring
homomorphism to a division ring").

Throughout, `φ : MonoidAlgebra K Λ →+* D` is a ring homomorphism from the group ring `K[Λ]` to a
division ring `D`.  The ring `K` is only assumed to be a `Ring` (the paper takes a division ring
of characteristic `q`; nothing in this file uses more).

* `groupRingOn K C`: the subset `K[C] ⊆ K[Λ]` of elements supported in the subgroup `C`.
* `divClosure φ C` (`D_C`): the division closure of `φ(K[C])`, i.e. the smallest subfield
  (= subring closed under inverting nonzero elements, `divClosure_le_of_subring`) of `D`
  containing `φ(K[C])`.  `divClosure_eq_closure_single` shows it is generated by the elements
  `φ (single g k)`, `g ∈ C`, `k ∈ K`.
* `IsFreeFor φ C C'`: `(C, C')`-freeness.
* `IsEpic`, `IsLinnell`, `IsStronglyHughesFree`, `SatisfiesHF`.
* `PowersLeftIndep D₀ x`: the powers `x ^ k`, `k : ℤ`, are left linearly independent over `D₀`.
* `ZQuotientData`: a subgroup `A`, a homomorphism `δ : A → ℤ` (written `A →* Multiplicative ℤ`)
  with kernel `A0`, and `t ∈ A` with `δ t = 1`; the facts about such data used in the proof of
  `thm:linnell` (the `t ^ k` lie in distinct right cosets of `A0`, `A0` is normal in `A`, and
  `A / A0` is infinite cyclic generated by `t A0`).
-/

namespace NonSofic

open MonoidAlgebra

variable {K : Type*} [Ring K] {Λ : Type*} [Group Λ] {D : Type*} [DivisionRing D]

/-! ### Division closures -/

variable (K) in
/-- `K[C]`, as the set of elements of `K[Λ]` supported in `C`. -/
def groupRingOn (C : Subgroup Λ) : Set (MonoidAlgebra K Λ) :=
  {a | ∀ g ∈ a.coeff.support, g ∈ C}

/-- `D_C`: the division closure of `φ(K[C])` in `D`. -/
def divClosure (φ : MonoidAlgebra K Λ →+* D) (C : Subgroup Λ) : Subfield D :=
  Subfield.closure (φ '' groupRingOn K C)

theorem single_mem_groupRingOn {C : Subgroup Λ} {g : Λ} (hg : g ∈ C) (k : K) :
    single g k ∈ groupRingOn K C := by
  intro h hh
  rw [coeff_single] at hh
  rw [Finset.mem_singleton.1 (Finsupp.support_single_subset hh)]
  exact hg

theorem subset_divClosure (φ : MonoidAlgebra K Λ →+* D) (C : Subgroup Λ) :
    φ '' groupRingOn K C ⊆ divClosure φ C :=
  Subfield.subset_closure

theorem single_mem_divClosure (φ : MonoidAlgebra K Λ →+* D) {C : Subgroup Λ} {g : Λ}
    (hg : g ∈ C) (k : K) : φ (single g k) ∈ divClosure φ C :=
  subset_divClosure φ C ⟨_, single_mem_groupRingOn hg k, rfl⟩

theorem of_mem_divClosure (φ : MonoidAlgebra K Λ →+* D) {C : Subgroup Λ} {g : Λ}
    (hg : g ∈ C) : φ (of K Λ g) ∈ divClosure φ C :=
  single_mem_divClosure φ hg 1

/-- `D_C` is the subfield generated by the `φ (single g k)` with `g ∈ C`. -/
theorem divClosure_eq_closure_single (φ : MonoidAlgebra K Λ →+* D) (C : Subgroup Λ) :
    divClosure φ C = Subfield.closure {x | ∃ g ∈ C, ∃ k : K, φ (single g k) = x} := by
  apply le_antisymm
  · rw [divClosure, Subfield.closure_le]
    rintro _ ⟨a, ha, rfl⟩
    rw [← sum_coeff_single a, Finsupp.sum, map_sum]
    exact Subfield.sum_mem _ fun g hg =>
      Subfield.subset_closure ⟨g, ha g hg, a.coeff g, rfl⟩
  · rw [Subfield.closure_le]
    rintro _ ⟨g, hg, k, rfl⟩
    exact single_mem_divClosure φ hg k

/-- Minimality: `D_C` is contained in every subring of `D` that contains `φ(K[C])` and is closed
under inverting its nonzero elements. -/
theorem divClosure_le_of_subring (φ : MonoidAlgebra K Λ →+* D) (C : Subgroup Λ)
    (S : Subring D) (hS : φ '' groupRingOn K C ⊆ S) (hinv : ∀ x ∈ S, x ≠ 0 → x⁻¹ ∈ S) :
    (divClosure φ C : Set D) ⊆ S := by
  let F : Subfield D :=
    { S with
      inv_mem' := fun x hx => by
        by_cases h : x = 0
        · rw [h, inv_zero]; exact S.zero_mem
        · exact hinv x hx h }
  have : divClosure φ C ≤ F := Subfield.closure_le.2 hS
  exact fun x hx => this hx

/-- `D_C` is the least subring of `D` that contains `φ(K[C])` and is closed under inverting its
nonzero elements (the paper's definition of the division closure). -/
theorem divClosure_isLeast (φ : MonoidAlgebra K Λ →+* D) (C : Subgroup Λ) :
    IsLeast {S : Subring D | φ '' groupRingOn K C ⊆ S ∧ ∀ x ∈ S, x ≠ 0 → x⁻¹ ∈ S}
      (divClosure φ C).toSubring :=
  ⟨⟨subset_divClosure φ C, fun _ hx _ => (divClosure φ C).inv_mem hx⟩,
    fun S hS _ hx => divClosure_le_of_subring φ C S hS.1 hS.2 hx⟩

theorem divClosure_mono (φ : MonoidAlgebra K Λ →+* D) {C C' : Subgroup Λ} (h : C ≤ C') :
    divClosure φ C ≤ divClosure φ C' := by
  rw [divClosure_eq_closure_single, Subfield.closure_le]
  rintro _ ⟨g, hg, k, rfl⟩
  exact single_mem_divClosure φ (h hg) k

/-! ### Images of group elements -/

theorem map_of_mul_map_of_inv (φ : MonoidAlgebra K Λ →+* D) (g : Λ) :
    φ (of K Λ g) * φ (of K Λ g⁻¹) = 1 := by
  rw [← map_mul, ← map_mul, mul_inv_cancel, map_one, map_one]

theorem map_of_ne_zero (φ : MonoidAlgebra K Λ →+* D) (g : Λ) : φ (of K Λ g) ≠ 0 := by
  intro h
  have := map_of_mul_map_of_inv φ g
  rw [h, zero_mul] at this
  exact zero_ne_one this

theorem map_of_inv (φ : MonoidAlgebra K Λ →+* D) (g : Λ) :
    φ (of K Λ g⁻¹) = (φ (of K Λ g))⁻¹ :=
  (eq_inv_of_mul_eq_one_right (map_of_mul_map_of_inv φ g))

theorem map_of_zpow (φ : MonoidAlgebra K Λ →+* D) (t : Λ) (k : ℤ) :
    φ (of K Λ (t ^ k)) = φ (of K Λ t) ^ k := by
  let f : Λ →* D := φ.toMonoidHom.comp (of K Λ)
  exact map_zpow' f (fun g => map_of_inv φ g) t k

/-! ### Freeness and the classes of division rings -/

/-- `(C, C')`-freeness (paper, Section 5): `∑ⱼ dⱼ φ(gⱼ) ≠ 0` whenever `g₁, …, gₙ ∈ C'`
(`n ≥ 1`) lie in distinct right cosets of `C` (i.e. `gᵢ gⱼ⁻¹ ∉ C` for `i ≠ j`) and
`d₁, …, dₙ ∈ D_C` are nonzero. -/
def IsFreeFor (φ : MonoidAlgebra K Λ →+* D) (C C' : Subgroup Λ) : Prop :=
  ∀ (n : ℕ) (g : Fin n → Λ) (d : Fin n → D), 0 < n → (∀ j, g j ∈ C') →
    (∀ i j, i ≠ j → g i * (g j)⁻¹ ∉ C) → (∀ j, d j ∈ divClosure φ C) → (∀ j, d j ≠ 0) →
      ∑ j, d j * φ (of K Λ (g j)) ≠ 0

/-- `D` is epic: `D_Λ = D`. -/
def IsEpic (φ : MonoidAlgebra K Λ →+* D) : Prop :=
  divClosure φ ⊤ = ⊤

/-- Linnell: epic and `(C, Λ)`-free for every subgroup `C`.

`φ` is not required to be injective. A Linnell division ring for `K[Λ]` in the paper (after
[JZL2025, FSP2026]) contains a copy of `K[Λ]`, i.e. `φ` injective; so this `IsLinnell` is weaker
than the paper's notion (more `φ` satisfy it), and `¬ IsLinnell φ` for all `φ` is stronger. -/
def IsLinnell (φ : MonoidAlgebra K Λ →+* D) : Prop :=
  IsEpic φ ∧ ∀ C : Subgroup Λ, IsFreeFor φ C ⊤

/-- `C` is a normal subgroup of `C'` (with `C ≤ C'`). -/
def IsNormalIn (C C' : Subgroup Λ) : Prop :=
  C ≤ C' ∧ ∀ x ∈ C', ∀ c ∈ C, x * c * x⁻¹ ∈ C

/-- Strongly Hughes-free (Linnell): epic and `(C, C')`-free whenever `C` is normal in `C'`.
As for `IsLinnell`, `φ` is not required to be injective. -/
def IsStronglyHughesFree (φ : MonoidAlgebra K Λ →+* D) : Prop :=
  IsEpic φ ∧ ∀ C C' : Subgroup Λ, IsNormalIn C C' → IsFreeFor φ C C'

/-- The powers `x ^ k`, `k ∈ ℤ`, are left linearly independent over `D₀`. -/
def PowersLeftIndep (D₀ : Subfield D) (x : D) : Prop :=
  ∀ (s : Finset ℤ) (c : ℤ → D), (∀ k ∈ s, c k ∈ D₀) → ∑ k ∈ s, c k * x ^ k = 0 →
    ∀ k ∈ s, c k = 0

/-- `C'` is finitely generated (the classical definition: generated by a finite set). -/
def IsFinitelyGenerated (C' : Subgroup Λ) : Prop :=
  ∃ S : Finset Λ, Subgroup.closure (S : Set Λ) = C'

/-- `IsFinitelyGenerated` agrees with Mathlib's `Subgroup.FG`. -/
theorem isFinitelyGenerated_iff_fg (C' : Subgroup Λ) : IsFinitelyGenerated C' ↔ C'.FG := by
  rw [Subgroup.fg_iff]
  constructor
  · rintro ⟨S, hS⟩
    exact ⟨S, hS, S.finite_toSet⟩
  · rintro ⟨S, hS, hfin⟩
    exact ⟨hfin.toFinset, by rw [Set.Finite.coe_toFinset]; exact hS⟩

/-- `C'/C` is infinite cyclic, generated by `tC` (for `C` normal in `C'`): `t ∈ C'`, every
coset `gC` (`g ∈ C'`) is `tᵏC` for some `k ∈ ℤ`, and `tᵏ ∈ C` only for `k = 0`. -/
def IsInfCyclicQuotient (C C' : Subgroup Λ) (t : Λ) : Prop :=
  t ∈ C' ∧ (∀ g ∈ C', ∃ k : ℤ, (t ^ k)⁻¹ * g ∈ C) ∧ ∀ k : ℤ, t ^ k ∈ C → k = 0

/-- Condition (HF) of [FSP2026, Definition 2.2(1)]: whenever `C' ≤ Λ` is finitely generated,
`C` is normal in `C'` and `C'/C` is infinite cyclic generated by `tC`, the powers `φ(t)ᵏ`,
`k ∈ ℤ`, are left linearly independent over `D_C`.

No epicness or injectivity of `φ` is assumed here ([FSP2026]'s Hughes-free division rings are
injective, epic and satisfy (HF)). -/
def SatisfiesHF (φ : MonoidAlgebra K Λ →+* D) : Prop :=
  ∀ (C C' : Subgroup Λ) (t : Λ), IsFinitelyGenerated C' → IsNormalIn C C' →
    IsInfCyclicQuotient C C' t → PowersLeftIndep (divClosure φ C) (φ (of K Λ t))

/-! ### Basic lemmas -/

/-- `(C, C')`-free implies `(C, C'')`-free for `C ≤ C'' ≤ C'` (only `C'' ≤ C'` is needed). -/
theorem IsFreeFor.mono {φ : MonoidAlgebra K Λ →+* D} {C C' C'' : Subgroup Λ}
    (h : IsFreeFor φ C C') (h' : C'' ≤ C') : IsFreeFor φ C C'' :=
  fun n g d hn hg hc hd hd0 => h n g d hn (fun j => h' (hg j)) hc hd hd0

/-- The equivalent "linear independence" form of freeness: a vanishing combination with
coefficients in `D_C` of elements in distinct right cosets has all coefficients zero. -/
theorem IsFreeFor.coeff_eq_zero {φ : MonoidAlgebra K Λ →+* D} {C C' : Subgroup Λ}
    (h : IsFreeFor φ C C') {n : ℕ} (g : Fin n → Λ) (d : Fin n → D) (hg : ∀ j, g j ∈ C')
    (hc : ∀ i j, i ≠ j → g i * (g j)⁻¹ ∉ C) (hd : ∀ j, d j ∈ divClosure φ C)
    (hsum : ∑ j, d j * φ (of K Λ (g j)) = 0) : ∀ j, d j = 0 := by
  classical
  by_contra hne
  push Not at hne
  -- restrict to the nonzero coefficients
  obtain ⟨s, hs_def⟩ : ∃ s : Finset (Fin n), s = Finset.univ.filter fun j => d j ≠ 0 :=
    ⟨_, rfl⟩
  have hs : s.Nonempty := by
    obtain ⟨j, hj⟩ := hne
    exact ⟨j, by simp [hs_def, hj]⟩
  have hsum' : ∑ j : Fin s.card, d (s.equivFin.symm j) * φ (of K Λ (g (s.equivFin.symm j))) =
      0 := by
    have h1 : ∑ j : Fin s.card, d (s.equivFin.symm j) * φ (of K Λ (g (s.equivFin.symm j))) =
        ∑ j : s, d j * φ (of K Λ (g j)) :=
      Fintype.sum_equiv s.equivFin.symm _ _ (fun _ => rfl)
    rw [h1, Finset.sum_coe_sort s (fun j => d j * φ (of K Λ (g j))), hs_def,
      Finset.sum_filter_of_ne]
    · exact hsum
    · intro j _ hj hd0
      apply hj
      rw [hd0, zero_mul]
  refine h s.card (fun j => g (s.equivFin.symm j)) (fun j => d (s.equivFin.symm j))
    (Finset.card_pos.2 hs) (fun j => hg _) (fun i j hij => hc _ _ ?_) (fun j => hd _)
    (fun j => ?_) hsum'
  · intro heq
    exact hij (s.equivFin.symm.injective (Subtype.ext heq))
  · have hmem : ∀ k ∈ s, d k ≠ 0 := by
      intro k hk
      rw [hs_def, Finset.mem_filter] at hk
      exact hk.2
    exact hmem _ (s.equivFin.symm j).2

/-- Powers of an element `t` with `tᵏ ∈ C ⇒ k = 0` lie in distinct right cosets of `C`. -/
theorem zpow_mul_inv_zpow_notMem {C : Subgroup Λ} {t : Λ}
    (ht : ∀ k : ℤ, t ^ k ∈ C → k = 0) {k l : ℤ} (hkl : k ≠ l) : t ^ k * (t ^ l)⁻¹ ∉ C := by
  intro h
  rw [← zpow_neg, ← zpow_add] at h
  exact hkl (by have := ht _ h; omega)

/-- Freeness gives left independence of the powers of `φ(t)` over `D_C`, if all `tᵏ ∈ C'` and
the `tᵏ` lie in distinct right cosets of `C`. -/
theorem IsFreeFor.powersLeftIndep {φ : MonoidAlgebra K Λ →+* D} {C C' : Subgroup Λ}
    (h : IsFreeFor φ C C') (t : Λ) (htC' : ∀ k : ℤ, t ^ k ∈ C')
    (ht : ∀ k : ℤ, t ^ k ∈ C → k = 0) : PowersLeftIndep (divClosure φ C) (φ (of K Λ t)) := by
  classical
  intro s c hc hsum
  set e := s.equivFin.symm
  have hsum' : ∑ j : Fin s.card, c (e j) * φ (of K Λ (t ^ (e j : ℤ))) = 0 := by
    have h1 : ∑ j : Fin s.card, c (e j) * φ (of K Λ (t ^ (e j : ℤ))) =
        ∑ j : s, c j * φ (of K Λ t) ^ (j : ℤ) :=
      Fintype.sum_equiv e _ _ (fun j => by rw [map_of_zpow])
    rw [h1, Finset.sum_coe_sort s (fun j => c j * φ (of K Λ t) ^ j)]
    exact hsum
  have := h.coeff_eq_zero (fun j => t ^ (e j : ℤ)) (fun j => c (e j)) (fun j => htC' _)
    (fun i j hij => zpow_mul_inv_zpow_notMem ht fun heq => hij (e.injective (Subtype.ext heq)))
    (fun j => hc _ (e j).2) hsum'
  intro k hk
  have := this (e.symm ⟨k, hk⟩)
  simpa using this

theorem IsLinnell.powersLeftIndep {φ : MonoidAlgebra K Λ →+* D} (h : IsLinnell φ)
    {C : Subgroup Λ} {t : Λ} (ht : ∀ k : ℤ, t ^ k ∈ C → k = 0) :
    PowersLeftIndep (divClosure φ C) (φ (of K Λ t)) :=
  (h.2 C).powersLeftIndep t (fun _ => Subgroup.mem_top _) ht

theorem IsStronglyHughesFree.powersLeftIndep {φ : MonoidAlgebra K Λ →+* D}
    (h : IsStronglyHughesFree φ) {C C' : Subgroup Λ} (hN : IsNormalIn C C') {t : Λ}
    (htC' : t ∈ C') (ht : ∀ k : ℤ, t ^ k ∈ C → k = 0) :
    PowersLeftIndep (divClosure φ C) (φ (of K Λ t)) :=
  (h.2 C C' hN).powersLeftIndep t (fun k => C'.zpow_mem htC' k) ht

/-- In an infinite cyclic quotient `C'/C = ⟨tC⟩`, the `tᵏ` lie in distinct right cosets of `C`. -/
theorem IsInfCyclicQuotient.zpow_mul_inv_zpow_notMem {C C' : Subgroup Λ} {t : Λ}
    (h : IsInfCyclicQuotient C C' t) {k l : ℤ} (hkl : k ≠ l) : t ^ k * (t ^ l)⁻¹ ∉ C :=
  NonSofic.zpow_mul_inv_zpow_notMem h.2.2 hkl

/-- Linnell ⇒ strongly Hughes-free. -/
theorem IsLinnell.isStronglyHughesFree {φ : MonoidAlgebra K Λ →+* D} (h : IsLinnell φ) :
    IsStronglyHughesFree φ :=
  ⟨h.1, fun C _ _ => (h.2 C).mono le_top⟩

/-- Strongly Hughes-free ⇒ (HF). -/
theorem IsStronglyHughesFree.satisfiesHF {φ : MonoidAlgebra K Λ →+* D}
    (h : IsStronglyHughesFree φ) : SatisfiesHF φ :=
  fun _ _ _ _ hN hQ => h.powersLeftIndep hN hQ.1 hQ.2.2

/-- Linnell ⇒ (HF). -/
theorem IsLinnell.satisfiesHF {φ : MonoidAlgebra K Λ →+* D} (h : IsLinnell φ) :
    SatisfiesHF φ :=
  h.isStronglyHughesFree.satisfiesHF

/-! ### Infinite cyclic quotients given by a homomorphism to `ℤ` -/

/-- A subgroup `A ≤ Λ`, a homomorphism `δ : A → ℤ` and `t ∈ A` with `δ t = 1`. Its kernel,
as a subgroup of `Λ`, is `A0`. -/
structure ZQuotientData (Λ : Type*) [Group Λ] where
  /-- The subgroup `A`. -/
  A : Subgroup Λ
  /-- The homomorphism `δ : A → ℤ`. -/
  δ : A →* Multiplicative ℤ
  /-- The element `t`. -/
  t : Λ
  t_mem : t ∈ A
  δ_t : δ ⟨t, t_mem⟩ = Multiplicative.ofAdd 1

namespace ZQuotientData

variable (Q : ZQuotientData Λ)

/-- `A0 = ker δ`, as a subgroup of `Λ`. -/
def A0 : Subgroup Λ := Q.δ.ker.map Q.A.subtype

theorem mem_A0 {g : Λ} : g ∈ Q.A0 ↔ ∃ h : g ∈ Q.A, Q.δ ⟨g, h⟩ = 1 := by
  constructor
  · rintro ⟨⟨a, ha⟩, hker, rfl⟩
    exact ⟨ha, hker⟩
  · rintro ⟨h, hδ⟩
    exact ⟨⟨g, h⟩, hδ, rfl⟩

theorem A0_le : Q.A0 ≤ Q.A := by
  intro g hg
  exact ((Q.mem_A0).1 hg).1

theorem δ_zpow_t (k : ℤ) :
    Q.δ ⟨Q.t ^ k, Q.A.zpow_mem Q.t_mem k⟩ = Multiplicative.ofAdd k := by
  have : (⟨Q.t ^ k, Q.A.zpow_mem Q.t_mem k⟩ : Q.A) = ⟨Q.t, Q.t_mem⟩ ^ k := rfl
  rw [this, map_zpow, Q.δ_t, ← ofAdd_zsmul, smul_eq_mul, mul_one]

/-- `tᵏ ∈ A0` only for `k = 0`; hence the `tᵏ` lie in distinct right cosets of `A0`. -/
theorem zpow_mem_A0 {k : ℤ} (h : Q.t ^ k ∈ Q.A0) : k = 0 := by
  obtain ⟨_, hδ⟩ := (Q.mem_A0).1 h
  rw [Q.δ_zpow_t] at hδ
  simpa using hδ

/-- The elements `tᵏ` (`k ∈ ℤ`) lie in distinct right cosets of `A0`. -/
theorem zpow_mul_inv_zpow_notMem_A0 {k l : ℤ} (hkl : k ≠ l) :
    Q.t ^ k * (Q.t ^ l)⁻¹ ∉ Q.A0 :=
  zpow_mul_inv_zpow_notMem (fun _ h => Q.zpow_mem_A0 h) hkl

/-- `A0` is normal in `A`. -/
theorem isNormalIn : IsNormalIn Q.A0 Q.A := by
  refine ⟨Q.A0_le, fun x hx c hc => ?_⟩
  obtain ⟨hcA, hδc⟩ := (Q.mem_A0).1 hc
  refine (Q.mem_A0).2 ⟨Q.A.mul_mem (Q.A.mul_mem hx hcA) (Q.A.inv_mem hx), ?_⟩
  have : (⟨x * c * x⁻¹, Q.A.mul_mem (Q.A.mul_mem hx hcA) (Q.A.inv_mem hx)⟩ : Q.A) =
      ⟨x, hx⟩ * ⟨c, hcA⟩ * (⟨x, hx⟩ : Q.A)⁻¹ := rfl
  rw [this, map_mul, map_mul, map_inv, hδc, mul_one, mul_inv_cancel]

/-- `A / A0` is infinite cyclic, generated by `t A0`. -/
theorem isInfCyclicQuotient : IsInfCyclicQuotient Q.A0 Q.A Q.t := by
  refine ⟨Q.t_mem, fun g hg => ?_, fun k hk => Q.zpow_mem_A0 hk⟩
  refine ⟨Multiplicative.toAdd (Q.δ ⟨g, hg⟩), (Q.mem_A0).2 ⟨?_, ?_⟩⟩
  · exact Q.A.mul_mem (Q.A.inv_mem (Q.A.zpow_mem Q.t_mem _)) hg
  · set k := Multiplicative.toAdd (Q.δ ⟨g, hg⟩)
    have : (⟨(Q.t ^ k)⁻¹ * g, Q.A.mul_mem (Q.A.inv_mem (Q.A.zpow_mem Q.t_mem _)) hg⟩ : Q.A) =
        (⟨Q.t ^ k, Q.A.zpow_mem Q.t_mem k⟩ : Q.A)⁻¹ * ⟨g, hg⟩ := rfl
    rw [this, map_mul, map_inv, Q.δ_zpow_t]
    simp [k]

/-- Conjugation by `t` preserves `A0`. -/
theorem conj_mem_A0 {g : Λ} (hg : g ∈ Q.A0) : Q.t * g * Q.t⁻¹ ∈ Q.A0 :=
  Q.isNormalIn.2 Q.t Q.t_mem g hg

end ZQuotientData

end NonSofic
